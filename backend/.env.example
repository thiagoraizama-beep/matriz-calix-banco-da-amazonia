PORT=4000

# Modo de dados: "mock" usa dados de exemplo embutidos; "sheets" busca no Google Sheets real
DATA_SOURCE=mock

# Necessario apenas quando DATA_SOURCE=sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SHEET_ID=
SHEET_RANGE_REALIZADO=Realizado!A:Z
SHEET_RANGE_PLANEJAMENTO=Planejamento!A:Z

# GA4 (sessoes/leads por criativo, casados pela URL de destino cadastrada) -- usa a
# mesma service account acima, que precisa ser adicionada como Viewer na propriedade
# GA4 de cada campanha (Property ID cadastrado em Perfil > Integracoes GA4).
# Nome do evento de conversao de "lead" configurado no GA4 (ex: generate_lead).
# Sem isso, a metrica de Leads fica indisponivel ("Nao configurado"), sem quebrar o resto.
GA4_LEAD_EVENT_NAME=

# Cloudinary - hospedagem das imagens dos criativos e logos de veiculo.
# Use uma conta EXCLUSIVA por cliente/projeto (nao reaproveitar entre clientes
# diferentes) para nao misturar arquivos nem estourar o limite gratuito.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CREATIVES_FOLDER=criativos
CLOUDINARY_VEHICLES_FOLDER=logos-veiculos

# Autenticacao
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Secret que protege GET /api/status-sync/cron (chamada pelo Vercel Cron, sem cookie
# de sessao) -- o cron envia "Authorization: Bearer <CRON_SECRET>" automaticamente.
CRON_SECRET=

# Resend - usado para o envio do e-mail de recuperacao de senha.
# RESEND_API_KEY e secreta: nunca expor no frontend nem versionar.
# RESEND_FROM: remetente verificado em resend.com/domains; onboarding@resend.dev
# funciona sem verificar dominio, mas so entrega para o e-mail da conta Resend.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
